#!/bin/bash

if test "x$1" = "x"; then
   echo "Usage: parser [-d] nn-name_yyyy-mm-dd.sum1.ph2.xml  ... " >&2
   echo "   or         [-d] nn-name_yyyy-mm-dd.json.ph1.json ... " >&2
   exit
fi

debug=""
if test "x$1" = "x-d"; then
   debug="-d"
   shift
fi

# Handles:
#    .sum1.ph2.xml
#    .json.ph1.json
#    .man.ph2.man
#    (anything) .ph2.tab
#    .clarity.ph1.csv
#    .clarity.ph1.html
#    .state.ph1.csv

for x in $@; do
   if echo "$x" | grep "^x" >/dev/null; then
      continue
   fi

   electionDate=`echo "$x" | sed -E "s/^.*([0-9]{4}-[0-9]{2}-[0-9]{2}).*$/\\1/"`
   countyNum=`echo "$x" | sed "s/-.*$//"`
   state="n"
   if [[ "$x" == *"ph2.xml"* ]]; then
      lines=`wc -l $x`
      if test "$lines" = "3"; then
         echo "You must first run xmlClean on $x"
         continue
      elif grep "ss:Data" $x >/dev/null; then
         echo "You must first run xmlClean on $x"
         continue
      fi
   fi

   if [[ "$x" == *"sum1.ph2.xml"* ]]; then
      base=`basename $x .ph2.xml`
      phase03ParseXmlSummary1.php $electionDate $countyNum <$x  >/tmp/j3
      cp /tmp/j3 $base.ph3.tsv

   elif [[ "$x" == *"column.ph2.xml"* ]]; then
      base=`basename $x .ph2.xml`
      phase03ParseColumn.py $electionDate $countyNum <$x  >/tmp/j3
      cp /tmp/j3 $base.ph3.tsv

   elif [[ "$x" == *"clarity.ph1.csv"* ]]; then
      base=`basename $x .ph1.csv`
      grep -v Delegate  $x               | \
         grep -v ',"REP '                | \
         grep -v "Unassigned write-ins"  | \
         sed 's/,"DEM /,"/'              | \
         sed 's/,"NP- /,"/'              | \
         phase03Clarity.php  $electionDate $countyNum >$base.ph3.tsv 

   elif [[ "$x" == *"clarity.ph1.html"* ]]; then
      base=`basename $x .ph1.html`
      phase03ClarityHtml.php  $electionDate $countyNum <$x  >$base.ph3.tsv

   elif [[ "$x" == *"json.ph1.json"* ]]; then
      base=`basename $x .ph1.json`
      name=`basename $x`
      county=`echo $name | sed "s/-.*$//"`
      phase03ParseJson.py $county <$x  >$base.ph3.tsv

   elif [[ "$x" == *"state.ph1.csv"* ]]; then
      base=`basename $x .ph1.csv`
      parseStateResultsTsv.php <$x >$base.ph7.tsv   # Note phase SEVEN!
      state="y"

   elif [[ "$x" == *"man.ph2.man"* ]]; then
      base=`basename $x .ph2.man`
      cp $x $base.ph3.tsv

   elif [[ "$x" == *".ph2.tab"* ]]; then
      base=`basename $x .ph2.tab`
      cp $x $base.ph3.tsv

   else
      echo "No match for $x" >&2
      continue
   fi

   if test "$state" = "n"; then
      phase04IgnoreRaces.php  <$base.ph3.tsv | \
         grep -v Delegate          | \
         grep -v "(REP)"           | \
         grep -v "Write-in"        | \
         grep -v $'\tREP '         | \
         sed "s/\tDEM /\t/"  >/tmp/j4
      cp /tmp/j4 $base.ph4.tsv
   
      phase05ParseVotes.php   <$base.ph4.tsv >/tmp/j5
      cp /tmp/j5 $base.ph5.tsv
   
      phase06ParseOrg.php     <$base.ph5.tsv >/tmp/j6  $debug
      cp /tmp/j6 $base.ph6.tsv
   
      phase07Districts.php    <$base.ph6.tsv >/tmp/j7  $debug
      cp /tmp/j7 $base.ph7.tsv
   fi

   phase08TermLenFinder.php <$base.ph7.tsv >/tmp/j8
   cp /tmp/j8 $base.ph8.tsv
done
