#!/bin/bash

if test "x$1" = "x"; then
   echo "Usage: markComplete countyName" >&2
   exit
fi

cd $ELECTION_IMPORT/Counties

if test ! -d $1; then
   echo "No such county directory $1." >&2
   exit
fi

cd $1
date >complete
countyNum=`ls [0-9]* | head -n 1 | sed "s/-.*$//"`

echo "UPDATE v4counties SET complete=1 WHERE id=$countyNum" | my
