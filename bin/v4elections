#!/bin/bash
#
#---v4elections.  Build v4elections from (ONLY completed!) TSV data.  Apply known fix-ups.

echo "source $ELECTION_IMPORT/SQL/03-v4elections.sql" | my

#---For (ONLY) the imported counties, import the phase8 TSV files into v4elections.
cd $ELECTION_IMPORT/Counties
for x in *; do
   cd $x
   countyNum=`getCountyNum $x`
   if isImported $countyNum; then
      rm -f y*
      for f in *.ph8.tsv; do
         if test -f $f; then
            echo $f
            phase09db.php <$f 2>y.$f
            if [[ -f "y.$f" && ! -s "y.$f" ]]; then
               rm -f  y.$f
            fi
         fi
      done
   fi
   cd ..
done

ys=`ls Counties/*/y* 2>/dev/null | wc -l`
if test $ys -gt 0; then
   echo "These are the database errors.  Resolve them, or delete the files."
   ls -l Counties/*/y*
   exit
fi

#---Fix-ups #1: Apply goodparty and CER data and manually fixed termlens and voteFor's
cd $ELECTION_IMPORT
for s in ZeroFixes/2*.sql; do
   echo "source $s" | my
done

#---Fix-ups #2: Apply heuristics to fix as many termlen=0 rows as possible.
phase10clean.php  2018-11-06  2> buildAll.clean
phase10clean.php  2020-11-03  2>>buildAll.clean
phase10clean.php  2021-11-02  2>>buildAll.clean
phase10clean.php  2022-11-08  2>>buildAll.clean
phase10clean.php  2023-11-07  2>>buildAll.clean
phase10clean.php  2024-11-05  2>>buildAll.clean
phase10clean.php  2025-11-04  2>>buildAll.clean

#---Fix-ups #3: Fix termlen=0 cases where different row / same race has a valid termlen
rm -f buildAll.termlen
phase11termlen.php >buildAll.termlen
echo "source buildAll.termlen" | my

#---Fix-ups #4: Manchester changed from village to city in 2023.
echo "source SQL/11-v4FixManchester.sql" | my

#---Fix-ups #5: Some election reports have 'X' for unknown party.
echo "UPDATE v4elections SET party='?' WHERE party='X'" | my

#---Fix-ups #6: fix some counties that have a leading 0 in their district/county number.
echo "UPDATE v4seats SET district = district+0 WHERE org IN ('cnty', 'cnty-com') AND SUBSTRING(district, 1, 1) = '0'" | my

