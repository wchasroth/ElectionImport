#!/bin/bash
#
#---v4elections.  Build v4elections from (ONLY completed!) TSV data.  Apply known fix-ups.

echo "source $ELECTION_IMPORT/SQL/03-v4elections.sql" | my

#---For (ONLY) the completed counties, import the phase8 TSV files into v4elections.
cd $ELECTION_IMPORT/Counties
for x in *; do
   cd $x
   if test -s all-parsed; then
      rm -f y*
      for f in *.ph8.tsv; do
         if test -f $f; then
            echo $f
            phase09db.php <$f 2>y.$f
            if [[ -f "y.$f" && ! -s "y.$f" ]]; then
               rm -f  y.$f
            fi
         fi
      done
   fi
   cd ..
done

ys=`ls Counties/*/y* 2>/dev/null | wc -l`
if test $ys -gt 0; then
   echo "These are the database errors.  Resolve them, or delete the files."
   ls -l Counties/*/y*
   exit
fi

#---Fix-ups #1: Apply goodparty and CER data and manually fixed termlens and voteFor's
cd $ELECTION_IMPORT
for s in ZeroFixes/2*.sql; do
   echo "source $s" | my
done
exit

   phase10clean.php  2018-11-06
   phase10clean.php  2020-11-03
   phase10clean.php  2021-11-02
   phase10clean.php  2022-11-08
   phase10clean.php  2023-11-07
   phase10clean.php  2024-11-05
   phase10clean.php  2025-11-04

#---Section 6: fix missing termlen's, where same race in other year has a valid termlen
rm -f buildAll.termlen
php phase15termlen.php >buildAll.termlen
echo "source buildAll.termlen" | my

#---phase15deletSeats??

#---Fixes for Manchester, which changed from village to city in 2023.
echo "source 29-fixManchester.sql" | my
