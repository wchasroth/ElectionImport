replaceIncumbent "Kristine Bolhuis"    "s.org='town'     AND s.district=3020  AND s.office='town-clerk'"
replaceIncumbent "Jacquelyn Bullerman" "s.org='city-cou' AND s.district=15020 AND i.name='Beth Morris'"
replaceIncumbent "Nicholia Heineman"   "s.org='schl-cou' AND s.district= 8940 AND i.name='Kate Henson'"
replaceIncumbent "Zakary McNitt"       "s.org='schl-cou' AND s.district=10050 AND i.name='Monica Renee VanTuyle'"
replaceIncumbent "Pavlo Popov"         "s.org='city-cou' AND s.district=22160 AND i.name='Zach Michels'"
replaceIncumbent "Sanam Aldag"         "s.org='city-cou' AND s.district=22160 AND i.name='Sanam Arab'"
replaceIncumbent "David Pisano"        "s.org='schl-cou' AND s.district=12030 AND i.name='Brian J. Arnold'"
