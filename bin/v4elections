#!/bin/bash
#
#---v4elections.  Build the master tables that derive or are used in

#---Create the empty v4elections table
echo "source $ELECTION_IMPORT/SQL/03-v4elections.sql" | my

#---For (ONLY) the completed counties, import the phase8 TSV files into v4elections.
cd $ELECTION_IMPORT/Counties
for x in *; do
   cd $x
   if test -s all-parsed; then
      rm -f y*
      for f in *.ph8.tsv; do
         if test -f $f; then
            echo $f
            phase09db.php <$f 2>y.$f
            if [[ -f "y.$f" && ! -s "y.$f" ]]; then
               rm -f  y.$f
            fi
         fi
      done
   fi
   cd ..
done

ys=`ls Counties/*/y* 2>/dev/null | wc -l`
if test $ys -gt 0; then
   echo "These are the database errors.  Resolve them, or delete the files."
   ls -l Counties/*/y*
   exit
fi
exit

#---Section 3: cleaning.  Attempt to fix bad values for voteFor.
rm -f $ELECTION_IMPORT/buildAll.*
(
   phase10clean.php  2018-11-06
   phase10clean.php  2020-11-03
   phase10clean.php  2021-11-02
   phase10clean.php  2022-11-08
   phase10clean.php  2023-11-07
   phase10clean.php  2024-11-05
   phase10clean.php  2025-11-04
) 2>$ELECTION_IMPORT/buildAll.clean

#---Some election reports have 'X' for unknown party.
echo "UPDATE elections SET party='?' WHERE party='X'" | my

#---Section 4: Dedup & Winners.  
#   Merge races that cross counties (e.g. some school boards)
#   Identify the winners, mark them with elections.winner=1
rm -f $ELECTION_IMPORT/buildAll.win
(
   phase11dedup.php  2018-11-06
   phase11dedup.php  2020-11-03
   phase11dedup.php  2021-11-02
   phase11dedup.php  2022-11-08
   phase11dedup.php  2023-11-07
   phase11dedup.php  2024-11-05
   phase11dedup.php  2025-11-04
  
   phase12winners.php    2018-11-06
   phase12winners.php    2020-11-03
   phase12winners.php    2021-11-02
   phase12winners.php    2022-11-08
   phase12winners.php    2023-11-07
   phase12winners.php    2024-11-05
   phase12winners.php    2025-11-04
) 2>$ELECTION_IMPORT/buildAll.win
exit

#---Section 5: Apply goodparty and CER data and manually fixed termlens and voteFor's
for s in REPORT/2*.sql; do
   echo "source $s" | my
done

#---Section 6: fix missing termlen's, where same race in other year has a valid termlen
rm -f buildAll.termlen
php phase15termlen.php >buildAll.termlen
echo "source buildAll.termlen" | my

echo "source 28-termsource.sql" | my
php phase16termsource.php >buildAll.termsource

#---Fixes for Manchester, which changed from village to city in 2023.
echo "source 29-fixManchester.sql" | my

#---Section 7:
#   Completely empty the v3seats and v3incumbents table,
#   and rebuild their contents from the elections table.

echo "source 26-v3seats.sql"      | my
echo "source 24-v3incumbents.sql" | my
rm -f buildAll.com1 buildAll.com2
(
   php phase14compress.php 2018-11-06 2>>buildAll.com2
   php phase14compress.php 2020-11-03 2>>buildAll.com2
   php phase14compress.php 2021-11-02 2>>buildAll.com2
   php phase14compress.php 2022-11-08 2>>buildAll.com2
   php phase14compress.php 2023-11-07 2>>buildAll.com2
   php phase14compress.php 2024-11-05 2>>buildAll.com2

   #---As of the 2024 election, all county commissioners were made 4 year terms, cycle matching presidential elections
   echo "UPDATE v3seats SET termlen=4, termcycle=2024 WHERE org='cnty-com'" | my

   php phase14compress.php 2025-11-04 2>>buildAll.com2
) >buildAll.com1

php phase15deleteSeats.php                  #---Seats that no longer exist, like us-hou 14

echo "source 27-v3lastelection.sql" | my >/dev/null   # Find the last election year for each county

php phase17expired.php  >buildAll.expired  #---Remove incumbents & seats that should have 'expired'

#---Remove known resignations or replacements not already covered.  Note syntax!
