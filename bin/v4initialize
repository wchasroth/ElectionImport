#!/bin/bash
#
#---v4initialize.  Wipe all parsed files and databases, start clean.

echo ""
echo -n "Are you absolutely sure you want to wipe and recreate everything? [n] "
read a
if test "x$a" != "xy"; then
   echo "Aborted."
   exit
fi

#---Initialize all v4 tables.
cd $ELECTION_IMPORT/SQL
echo "source 01-v4seats.sql"          | my
echo "source 02-v4incumbents.sql"     | my
echo "source 03-v4elections.sql"      | my
echo "source 09-v4termlen.sql"        | my

#---These tables will eventuallly become (mostly) static.
echo "source 04-v4jurisdictions.sql"  | my   # Cities need complete = 0 at the outset.
echo "source 05-v4titles.sql"         | my
echo "source 06-v4villages.sql"       | my
echo "source 07-v4schools.sql"        | my   # complete = 0
echo "source 08-v4commcolleges.sql"   | my   # complete = 0
echo "source 10-v4counties.sql"       | my   # complete = 0

#---Fill v4termlen table with data from Vishu's AI work.
cd $ELECTION_IMPORT/Vishu
for x in *.csv; do
   importTermLen.php $x
done
for x in *.sql; do
   echo "source $x" | my
done

#---Wipe all parsed election county files, and re-parse them.
cd $ELECTION_IMPORT/Counties
rm -f */.tsv
rm -f */all-parsed
rm -f */complete
rm -f */x*
rm -f */y*

for x in *; do
   if test -d $x; then 
      cd $x
      for f in *.sum1.ph2.xml    *.json.ph1.json *.man.ph2.man *.ph2.tab \
               *.clarity.ph1.csv *.clarity.ph1.html  *.state.ph1.csv;  do
         if test -f $f; then
            echo $f
            parser $f 2>x.$f
            if [[ -f "x.$f" && ! -s "x.$f" ]]; then
               rm -f x.$f
            fi
         fi
      done
      cd ..
   fi
done

#---Remove known error files (that are really OK)
rm -f barry/x.08-barry_2024-11-05.sum1.ph2.xml
rm -f iron/x.36-iron_2020-11-03.sum1.ph2.xml
rm -f mackinac/x.49-mackinac_2020-11-03.sum1.ph2.xml
rm -f mackinac/x.49-mackinac_2021-11-02.sum1.ph2.xml

xs=`ls */x* 2>/dev/null | wc -l`
if test $xs -gt 0; then
   echo "These are the translation errors.  "
   echo "Resolve them, or delete the files and try again."
   ls -l */x*
fi
