#!/bin/bash

#---v4compress.  Determine the election winners, then layer each year's elections
#   on top of the existing v4incumbents, creating rows in v4seats as needed.
#
#   Uses v4completed to track which offices are "complete", and (must!) not be
#   calculated again!
#
#   E.g. a school district is only "complete" if all of the counties it is in, are
#   themselves completely imported.  At which point that school district's elections
#   are computed, layered into v4incumbents & v4seats... and never done again!

phase13stateCompressor.php     >v4compress.stdout   2>v4compress.stderr
phase13countyCompressor.php   >>v4compress.stdout   2>>v4compress.stderr
phase13townshipCompressor.php >>v4compress.stdout   2>>v4compress.stderr

phase13cityCompressor.php     >>v4compress.stdout   2>>v4compress.stderr
phase13villageCompressor.php  >>v4compress.stdout   2>>v4compress.stderr
phase13schoolCompressor.php   >>v4compress.stdout   2>>v4compress.stderr
phase13collegeCompressor.php  >>v4compress.stdout   2>>v4compress.stderr

ls -l v4compress.s*
