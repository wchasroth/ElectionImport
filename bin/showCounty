#!/bin/bash

if test "x$1" = "x"; then
   echo "Usage: showCounty county#" >&2
   exit
fi

cat <<END
SELECT s.org, 81 AS district, ' ' AS locale, s.office, s.seatnum, s.subdist, i.elected, i.party, 
       i.votes_C, TRUNCATE(( (i.votes_C * 1.0) / i.votes_T) * 100, 0) AS pct,
       s.termlen, IF(s.termlen = 0, '?', IF((2026 - s.termcycle) % s.termlen = 0, 'Y', ' ')) AS open,
       i.resigned AS Res, IF(i.partial=1, 'P', ' ') AS Part,
       i.name,
       i.status, i.web, i.email, i.phone, i.address, i.headshot, i.num2elect
  FROM      v4incumbents AS i
  LEFT JOIN v4seats      AS s  ON (i.seat_id = s.id)
 WHERE s.org = 'mi-sen'
   AND s.district IN (SELECT DISTINCT senate FROM s4streets WHERE county_code = $1)

UNION ALL

SELECT s.org, 81 AS district, '_' AS locale, s.office, s.seatnum, s.subdist, i.elected, i.party, 
       i.votes_C, TRUNCATE(( (i.votes_C * 1.0) / i.votes_T) * 100, 0) AS pct,
       s.termlen, IF(s.termlen = 0, '?', IF((2026 - s.termcycle) % s.termlen = 0, 'Y', ' ')) AS open,
       i.resigned AS Res, IF(i.partial=1, 'P', ' ') AS Part,
       i.name,
       i.status, i.web, i.email, i.phone, i.address, i.headshot, i.num2elect
  FROM      v4incumbents AS i
  LEFT JOIN v4seats      AS s  ON (i.seat_id = s.id)
 WHERE s.org = 'mi-hou'
   AND s.district IN (SELECT DISTINCT house FROM s4streets WHERE county_code = $1)

UNION ALL

SELECT s.org, 81 AS district, '__' AS locale, s.office, s.seatnum, s.subdist, i.elected, i.party, 
       i.votes_C, TRUNCATE(( (i.votes_C * 1.0) / i.votes_T) * 100, 0) AS pct,
       s.termlen, IF(s.termlen = 0, '?', IF((2026 - s.termcycle) % s.termlen = 0, 'Y', ' ')) AS open,
       i.resigned AS Res, IF(i.partial=1, 'P', ' ') AS Part,
       i.name,
       i.status, i.web, i.email, i.phone, i.address, i.headshot, i.num2elect
  FROM      v4incumbents AS i
  LEFT JOIN v4seats      AS s  ON (i.seat_id = s.id)
 WHERE s.org LIKE 'cnty%'
   AND s.district = $1

UNION ALL

SELECT s.org, j.id AS district, j.simplename AS locale, s.office, s.seatnum, s.subdist, i.elected, i.party, 
       i.votes_C, TRUNCATE(( (i.votes_C * 1.0) / i.votes_T) * 100, 0) AS pct,
       s.termlen, IF(s.termlen = 0, '?', IF((2026 - s.termcycle) % s.termlen = 0, 'Y', ' ')) AS open,
       i.resigned AS Res, IF(i.partial=1, 'P', ' ') AS Part,
       i.name,
       i.status, i.web, i.email, i.phone, i.address, i.headshot, i.num2elect
  FROM      v4incumbents AS i
  LEFT JOIN v4seats         AS s  ON (i.seat_id = s.id)
  LEFT JOIN s4jurisdictions AS j  ON (s.district = j.id)
 WHERE (s.org LIKE 'city%'  OR  s.org LIKE 'town%')
   AND j.county_id = $1

UNION ALL

SELECT s.org, v.id AS district, v.simplename AS locale, s.office, s.seatnum, s.subdist, i.elected, i.party, 
       i.votes_C, TRUNCATE(( (i.votes_C * 1.0) / i.votes_T) * 100, 0) AS pct,
       s.termlen, IF(s.termlen = 0, '?', IF((2026 - s.termcycle) % s.termlen = 0, 'Y', ' ')) AS open,
       i.resigned AS Res, IF(i.partial=1, 'P', ' ') AS Part,
       i.name,
       i.status, i.web, i.email, i.phone, i.address, i.headshot, i.num2elect
  FROM      v4incumbents AS i
  LEFT JOIN v4seats      AS s  ON (i.seat_id  = s.id)
  LEFT JOIN s4villages   AS v  ON (s.district = v.id)
 WHERE (s.org LIKE 'vil%')
   AND v.county_id = $1

UNION ALL

SELECT s.org, c.id AS district, c.simplename AS locale, s.office, s.seatnum, s.subdist, i.elected, i.party, 
       i.votes_C, TRUNCATE(( (i.votes_C * 1.0) / i.votes_T) * 100, 0) AS pct,
       s.termlen, IF(s.termlen = 0, '?', IF((2026 - s.termcycle) % s.termlen = 0, 'Y', ' ')) AS open,
       i.resigned AS Res, IF(i.partial=1, 'P', ' ') AS Part,
       i.name,
       i.status, i.web, i.email, i.phone, i.address, i.headshot, i.num2elect
  FROM      v4incumbents AS i
  LEFT JOIN v4seats      AS s ON (i.seat_id  = s.id)
  LEFT JOIN s4schools    AS c ON (s.district = c.id)
 WHERE s.org = 'schl-cou'
   AND c.county_id = $1

UNION ALL

SELECT s.org, c.id AS district, c.simplename AS locale, s.office, s.seatnum, s.subdist, i.elected, i.party, 
       i.votes_C, TRUNCATE(( (i.votes_C * 1.0) / i.votes_T) * 100, 0) AS pct,
       s.termlen, IF(s.termlen = 0, '?', IF((2026 - s.termcycle) % s.termlen = 0, 'Y', ' ')) AS open,
       i.resigned AS Res, IF(i.partial=1, 'P', ' ') AS Part,
       i.name,
       i.status, i.web, i.email, i.phone, i.address, i.headshot, i.num2elect
  FROM      v4incumbents          AS i
  LEFT JOIN v4seats               AS s ON (i.seat_id  = s.id)
  LEFT JOIN s4commcolleges        AS c ON (s.district = c.id)
  LEFT JOIN v4commcolleges_county AS y ON (c.id = y.id)
 WHERE s.org = 'comm-cou'
   AND y.county_id = $1

ORDER BY locale, org, office, seatnum, subdist, name;
END
