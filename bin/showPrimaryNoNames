#!/bin/bash

cat <<END

SELECT DISTINCT s.org, j.id AS district, j.simplename AS locale, s.office, s.seatnum, s.subdist, i.won, 
       s.termlen, s.termcycle, s.is_open AS vac,
       i.name,
       i.web, i.email, i.phone, i.headshot,
         (SELECT COUNT(*) FROM v4filings WHERE org=s.org AND office=s.office AND district=s.district AND subdist=s.subdist) AS filings
  FROM      v4seats         AS s  
  LEFT JOIN s4jurisdictions AS j  ON (s.district = j.id)
  LEFT JOIN v4candidates    AS i  ON (i.seat_id = s.id)
 WHERE (s.org LIKE 'city%'  OR  s.org LIKE 'town%')
   AND (s.termcycle=2026 OR s.is_open=1)
   AND (i.name IS NULL OR i.name='')

UNION ALL

SELECT DISTINCT s.org, v.id AS district, v.simplename AS locale, s.office, s.seatnum, s.subdist, i.won, 
       s.termlen, s.termcycle, s.is_open AS vac,
       i.name,
       i.web, i.email, i.phone, i.headshot, 
         (SELECT COUNT(*) FROM v4filings WHERE org=s.org AND office=s.office AND district=s.district AND subdist=s.subdist) AS filings
  FROM      v4seats      AS s  
  LEFT JOIN s4villages   AS v  ON (s.district = v.id)
  LEFT JOIN v4candidates AS i  ON (i.seat_id  = s.id)
 WHERE (s.org LIKE 'vil%')
   AND (s.termcycle=2026 OR s.is_open=1)
   AND (i.name IS NULL OR i.name='')

UNION ALL

SELECT DISTINCT s.org, c.id AS district, c.simplename AS locale, s.office, s.seatnum, s.subdist, i.won, 
       s.termlen, s.termcycle, s.is_open AS vac,
       i.name,
       i.web, i.email, i.phone, i.headshot, 
         (SELECT COUNT(*) FROM v4filings WHERE org=s.org AND office=s.office AND district=s.district AND subdist=s.subdist) AS filings
  FROM      v4seats      AS s
  LEFT JOIN s4schools    AS c  ON (s.district = c.id)
  LEFT JOIN v4candidates AS i  ON (i.seat_id  = s.id)
 WHERE s.org = 'schl-cou'
   AND (s.termcycle=2026 OR s.is_open=1)
   AND (i.name IS NULL OR i.name='')

UNION ALL

SELECT DISTINCT s.org, c.id AS district, c.simplename AS locale, s.office, s.seatnum, s.subdist, i.won, 
       s.termlen, s.termcycle, s.is_open AS vac,
       i.name,
       i.web, i.email, i.phone, i.headshot, 
         (SELECT COUNT(*) FROM v4filings WHERE org=s.org AND office=s.office AND district=s.district AND subdist=s.subdist) AS filings
  FROM      v4seats               AS s 
  LEFT JOIN s4commcolleges        AS c ON (s.district = c.id)
  LEFT JOIN v4commcolleges_county AS y ON (c.id = y.id)
  LEFT JOIN v4candidates          AS i ON (i.seat_id  = s.id)
 WHERE s.org = 'comm-cou'
   AND (s.termcycle=2026 OR s.is_open=1)
   AND (i.name IS NULL OR i.name='')

UNION ALL

SELECT DISTINCT s.org, c.shortname AS district, c.shortname AS locale, s.office, s.seatnum, s.subdist, i.won, 
       s.termlen, s.termcycle, s.is_open AS vac,
       i.name,
       i.web, i.email, i.phone, i.headshot, 
         (SELECT COUNT(*) FROM v4filings WHERE org=s.org AND office=s.office AND district=s.district AND subdist=s.subdist) AS filings
  FROM      v4seats        AS s 
  LEFT JOIN v4courts       AS c  ON (s.org = c.type AND s.district = c.shortname)
  LEFT JOIN v4candidates   AS i  ON (i.seat_id  = s.id)
 WHERE (s.org LIKE 'crt%' AND s.org != 'crt-sup')
   AND (s.termcycle=2026 OR s.is_open=1)
   AND (i.name IS NULL OR i.name='')
   AND  s.seatnum > 0

ORDER BY locale, org, office, seatnum, subdist, name;
END
